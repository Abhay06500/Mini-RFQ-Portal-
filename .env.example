# Copy to .env and replace every change_me / replace_* value. Never commit .env.
#
# Docker Compose reads this file automatically. Local (non-Docker) development uses the URLs below.

# ---- Database (MySQL 8) ----
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=rfq_dev
MYSQL_USER=rfq
# Use letters and digits only, so the value is safe inside a connection URL.
MYSQL_PASSWORD=change_me_db_password

# Local development URLs (ignored by Docker Compose, which builds its own URL from the values above)
DATABASE_URL="mysql://rfq:change_me_db_password@127.0.0.1:3306/rfq_dev"
TEST_DATABASE_URL="mysql://rfq:change_me_db_password@127.0.0.1:3306/rfq_test"

# ---- Authentication ----
# Long random string. Generate with: openssl rand -hex 48
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRES_IN=8h
# Needed only to create an ADMIN account through the API. Leave empty to disable admin self-registration.
ADMIN_INVITE_CODE=admin
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# ---- Files ----
# Local development: a folder outside any public web root. Docker uses a named volume at /data/uploads.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- Behaviour ----
PORT=4000
NODE_ENV=development
CLOSURE_SWEEP_INTERVAL_MS=60000
CORS_ORIGIN=http://localhost:5173

# Load the demo RFQs, quotations and accounts on first start (Docker). Safe to leave true: it is idempotent.
SEED_DEMO_DATA=true
# Host port for the web app in Docker Compose.
WEB_PORT=8080
